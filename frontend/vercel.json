{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nnk-backend.onrender.com/api/$1"
    },
    {
      "source": "/oauth2/(.*)",
      "destination": "https://nnk-backend.onrender.com/oauth2/$1"
    },
    {
      "source": "/login/oauth2/code/(.*)",
      "destination": "https://nnk-backend.onrender.com/login/oauth2/code/$1"
    },
    {
      "source": "/login/(.*)",
      "destination": "https://nnk-backend.onrender.com/login/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
